msgid "简单的例子"
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:30004
msgid "一个简单示例，演示了如何使用 GELU 激活函数的此功能："
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:30006
msgid "可以使用给定公式中的高斯误差函数来计算 GELU 激活函数："
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:40002
#, python-brace-format
msgid ""
"\n"
"\\text{GELU} = x\\Phi(x) = x \\cdot \\frac{1}{2} [1 + \\text{erf}(x / "
"\\sqrt{2})]\n"
msgstr ""

