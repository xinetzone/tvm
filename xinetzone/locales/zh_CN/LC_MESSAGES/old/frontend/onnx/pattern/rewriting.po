#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20002
msgid "ONNX 重写工具为用户提供了一个功能，可以根据用户提供的重写规则，将 ONNX 计算图中的某些模式替换为另一种模式。"
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20004
msgid "使用方法"
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20006
msgid "在计算图重写模式时，需要三个主要部分："
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20008
msgid "`target_pattern`：要匹配的原始模式。这个模式使用类似 ONNXScript 的算子编写函数。"
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20009
msgid "`replacement_pattern`：用于替换原始模式的模式。这个模式也使用类似 ONNXScript 的算子编写函数。"
msgstr ""

#: ../../doc/old/frontend/onnx/pattern/rewriting.ipynb:20010
msgid "`match_condition`（可选）：只有满足匹配条件时，才会进行模式重写。"
msgstr ""

