msgid "`SourceName source_name`：跨度所在文件的源代码名称。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30017
msgid "`int line`：跨度起始行号。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30018
msgid "`int column`：跨度起始列偏移量。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30019
msgid "`int end_line`：跨度结束行号。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30020
msgid "`int end_column`：跨度结束列偏移量。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30021
msgid ""
"`TVM_DLL Span(SourceName source_name, int line, int end_line, int column,"
" int end_column)`：构造函数，用于创建一个指定位置信息的 `Span` 对象。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30022
msgid ""
"`TVM_DLL Span Merge(const Span& other) "
"const`：合并两个跨度对象，将它们合并为一个跨度对象，以捕获组合后的区域。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30023
msgid ""
"`TVM_DEFINE_OBJECT_REF_METHODS(Span, ObjectRef, SpanNode)`：宏定义，用于声明 "
"`Span` 类的基类信息以及对象引用的方法。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40002
msgid "`SequentialSpanNode` 和 `SequentialSpan`"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40004
msgid "`SequentialSpanNode` 是一个用于存储多个源表达式生成的表达式跨度列表的类。它具有以下成员变量和方法："
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40005
msgid "`Array<Span> spans`：原始源跨度列表，用于构建顺序跨度。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40006
msgid ""
"`void VisitAttrs(AttrVisitor* v)`：访问者方法，用于在属性访问期间处理属性访问。它调用基类的 "
"`VisitAttrs` 方法，并访问 `spans` 属性。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40007
msgid ""
"`static constexpr const char* _type_key = "
"\"SequentialSpan\"`：静态常量字符指针，用于标识该类的类型键。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40008
msgid ""
"`TVM_DECLARE_FINAL_OBJECT_INFO(SequentialSpanNode, SpanNode)`：宏定义，用于声明 "
"`SequentialSpanNode` 类的最终对象信息。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40009
msgid ""
"`bool SEqualReduce(const SequentialSpanNode* other, SEqualReducer equal) "
"const`：静态成员函数，用于比较两个 `SequentialSpanNode` "
"对象的顺序跨度是否相等。它首先检查两个对象的跨度列表大小是否相同，如果不同则返回 "
"`false`。然后逐个比较每个跨度是否相等，如果有不相等的跨度则返回 `false`，否则返回 `true`。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40011
msgid "`SequentialSpan` 是一个引用类，属于 `SequentialSpanNode`。它具有以下成员变量和方法："
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40012
msgid ""
"`TVM_DLL SequentialSpan(Array<Span> "
"spans)`：构造函数，接受一个跨度列表作为参数，用于创建一个顺序跨度对象。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40013
msgid ""
"`TVM_DLL SequentialSpan(std::initializer_list<Span> "
"init)`：构造函数，接受一个初始化器列表作为参数，用于创建一个顺序跨度对象。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:40014
msgid ""
"`TVM_DEFINE_OBJECT_REF_METHODS(SequentialSpan, Span, "
"SequentialSpanNode)`：宏定义，用于声明 `SequentialSpan` 类的基类信息以及对象引用的方法。"
msgstr ""

