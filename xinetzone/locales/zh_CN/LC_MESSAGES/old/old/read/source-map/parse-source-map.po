#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30006
msgid "`int line`：起始行号。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30007
msgid "`int column`：起始列偏移量。"
