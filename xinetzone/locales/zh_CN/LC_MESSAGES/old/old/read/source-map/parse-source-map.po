#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30008
msgid "`int end_line`：结束行号。"
msgstr ""

#: ../../doc/old/old/read/source-map/parse-source-map.ipynb:30009
msgid "`int end_column`：结束列偏移量。"
msgstr ""

