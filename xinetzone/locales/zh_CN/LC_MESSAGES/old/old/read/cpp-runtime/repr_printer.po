msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:10004
msgid "源码 `tvm/include/tvm/node/repr_printer.h`"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20002
msgid "`ReprPrinter`"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20025
msgid "`ReprPrinter` 打印类，用于打印抽象语法树（AST）或中间表示（IR）节点。它包含以下成员变量和成员函数："
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20027
msgid "`std::ostream& stream`：输出流，用于将打印结果输出到指定的流中。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20028
#, python-brace-format
msgid "`int indent{0}`：缩进级别，用于控制打印时的缩进空格数。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20029
msgid ""
"`explicit ReprPrinter(std::ostream& stream)`：构造函数，接收一个输出流参数，并将其赋值给 "
"`stream` 成员变量。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20030
msgid ""
"`TVM_DLL void Print(const ObjectRef& node)`：打印节点的成员函数，接收 `ObjectRef` "
"类型的参数，表示要打印的节点。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20031
msgid "`TVM_DLL void PrintIndent()`：打印缩进的成员函数，用于在打印节点时添加适当的缩进。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20032
msgid ""
"`using FType = NodeFunctor<void(const ObjectRef&, ReprPrinter*)>`：定义了类型别名"
" `FType`，表示接受 `ObjectRef` 和 `ReprPrinter*` 参数的函数对象类型。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:20033
msgid "`TVM_DLL static FType& vtable()`：静态成员函数，返回 `FType` 类型的引用，用于注册到打印器中。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:30014
msgid ""
"这段代码是内联函数，用于重载 `operator<<` 运算符。它接受 `std::ostream` 引用和 `ObjectRef` "
"常量引用作为参数。函数的作用是将 `ObjectRef` 对象的内容输出到 `std::ostream` 中。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:30016
msgid ""
"在函数内部，首先创建了 `ReprPrinter` 对象，并将 `os` 作为参数传递给它。然后调用 `ReprPrinter` 对象的 "
"`Print` 方法，将 `n` 作为参数传递。最后返回 `os`，以便可以继续使用该流进行其他操作。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:30018
msgid "这个函数通常用于自定义对象的打印输出，使得在调试或日志记录时能够更方便地查看对象的内容。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:40028
msgid "这段代码是 C++ 中的类 `ReprPrinter` 的实现。这个类的主要功能是打印对象的内容。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:40030
msgid ""
"`Print(const ObjectRef& node)` 函数：这个函数接受 `ObjectRef` 类型的参数 "
"`node`，表示要打印的对象。首先，它获取对象的虚函数表（vtable），然后检查 `node` 是否已定义。如果 `node` "
"未定义，它将输出 `\"(nullptr)\"`；否则，它将检查虚函数表是否可以调度 "
"`node`。如果可以，它将调用虚函数表对应的函数；否则，它将输出对象的类型键和地址。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:40031
msgid "`PrintIndent()` 函数：这个函数用于在打印对象内容时添加缩进。它通过循环输出空格来实现缩进效果。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:40032
msgid "`vtable()` 函数：这个函数返回类的静态虚函数表实例。这是一个单例模式的实现，确保在整个程序中只有一个虚函数表实例。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50002
msgid "`Dump`"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50004
msgid "`Dump` 用于将节点信息输出到标准错误流（stderr）以供调试使用。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50006
msgid "第一个函数的声明如下："
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50010
msgid ""
"这个函数接受类型为 `runtime::ObjectRef` 的常量引用作为参数，表示输入的节点。函数没有返回值，并且使用了 `TVM_DLL` "
"宏来指定这是动态链接库中的函数。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50012
msgid "第二个函数的声明如下："
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50016
msgid ""
"这个函数接受类型为 `runtime::Object` 的常量指针作为参数，表示输入的节点。函数同样没有返回值，并且也使用了 `TVM_DLL` "
"宏来指定这是动态链接库中的函数。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:50018
msgid "这两个函数的作用是将节点的信息输出到标准错误流，以便开发人员可以查看和调试。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:70002
msgid "这段代码定义了三个函数，以及全局注册的 TVM 模块。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:70004
msgid ""
"`void Dump(const runtime::ObjectRef& n)`：这个函数接受 `runtime::ObjectRef` "
"类型的参数 `n`，并将其输出到标准错误流（std::cerr）。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:70005
msgid ""
"`void Dump(const runtime::Object* n)`：这个函数接受指向 `runtime::Object` 的指针 "
"`n`，然后调用 `Dump` 函数将其转换为 `runtime::ObjectRef` 类型，并输出到标准错误流。"
msgstr ""

#: ../../doc/old/old/read/cpp-runtime/repr_printer.ipynb:70007
msgid ""
"`TVM_REGISTER_GLOBAL(\"node.AsRepr\")`：这是 TVM 模块的全局注册，用于将名为 "
"`\"node.AsRepr\"` 的函数注册到 TVM 运行时环境中。这个函数接受 `runtime::ObjectRef` "
"类型的参数，将其转换为字符串，并返回。 总结：这段代码定义了用于打印对象引用的函数，以及 TVM 模块的全局注册。"
msgstr ""

